# Template only: this is the one .env file that's committed. Never put real values here.
#
# Copy it to .env.development and fill in the DEV project's values
# (Supabase dashboard → firsttouch-dev → Project Settings → API Keys).
# `npx expo start` loads .env.development automatically.
#
# There is deliberately NO .env.production. Prod values live only in Cloudflare
# Pages (Production environment variables), so a build on your machine can never
# point at prod.
EXPO_PUBLIC_SUPABASE_URL=https://<dev-project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
